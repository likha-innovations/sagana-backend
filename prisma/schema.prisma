generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id /// Clerk User ID (user_2bX...)
  fullName      String?
  email         String   @unique
  contactNumber String?
  location      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}
