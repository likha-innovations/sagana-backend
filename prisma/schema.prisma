generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Barangay {
  id        String   @id @default(cuid()) @map("barangay_id")
  name      String
  code      String?  @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  users    User[]
  machines Machine[]

  @@map("barangays")
}

model User {
  id         String    @id @map("user_id") /// Clerk User ID (user_2bX...)
  barangayId String?   @map("barangay_id")
  fullName   String?   @map("name")
  birthday   DateTime?
  email      String    @unique
  role       String    @default("operator")
  status     String    @default("active")
  verificationStatus String @default("unverified") @map("verification_status")
  createdAt  DateTime  @default(now()) @map("created_at")

  barangay Barangay?      @relation(fields: [barangayId], references: [id])
  batches  CompostBatch[]

  @@map("users")
}

model Machine {
  id         String    @id @default(cuid()) @map("machine_id")
  barangayId String    @map("barangay_id")
  macAddress String    @unique @map("mac_address")
  name       String
  status     String    @default("offline")
  wifiSsid   String?   @map("wifi_ssid")
  lastSeen   DateTime? @map("last_seen")
  createdAt  DateTime  @default(now()) @map("created_at")
  removedAt  DateTime? @map("removed_at")

  barangay       Barangay        @relation(fields: [barangayId], references: [id])
  batches        CompostBatch[]
  sensors        Sensor[]
  telemetryLogs  TelemetryLog[]
  automationLogs AutomationLog[]

  @@map("machines")
}

model TelemetryLog {
  id         String   @id @default(cuid()) @map("telemetry_id")
  machineId  String   @map("machine_id")
  macAddress String   @map("mac_address")
  payload    Json     @map("payload")
  recordedAt DateTime @default(now()) @map("recorded_at")

  machine Machine @relation(fields: [machineId], references: [id])

  @@map("telemetry_logs")
}

model AutomationLog {
  id        String   @id @default(cuid()) @map("log_id")
  machineId String   @map("machine_id")
  batchId   String?  @map("batch_id")
  type      String   @map("type")
  message   String   @map("message")
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")

  machine Machine       @relation(fields: [machineId], references: [id])
  batch   CompostBatch? @relation(fields: [batchId], references: [id])

  @@index([machineId, createdAt])
  @@index([batchId, createdAt])
  @@map("automation_logs")
}

model CompostBatch {
  id             String    @id @default(cuid()) @map("batch_id")
  machineId      String    @map("machine_id")
  userId         String    @map("user_id")
  totalWeight    Float     @map("total_weight")
  finalWeight    Float?    @map("final_weight")
  batchCode      String    @unique @map("batch_code")
  startDate      DateTime  @map("start_date")
  completionDate DateTime? @map("completion_date")
  status         String    @default("active")

  machine          Machine           @relation(fields: [machineId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  feedstocks       BatchFeedstock[]
  compostingPhases CompostingPhase[]
  sensorReadings   SensorReading[]
  automationLogs   AutomationLog[]

  @@map("compost_batches")
}

model Feedstock {
  id          String  @id @default(cuid()) @map("feedstock_id")
  name        String
  category    String
  description String?
  status      String  @default("active")

  batchFeedstocks BatchFeedstock[]

  @@map("feedstocks")
}

model BatchFeedstock {
  id          String @id @default(cuid()) @map("batch_feedstock_id")
  batchId     String @map("batch_id")
  feedstockId String @map("feedstock_id")
  weight      Float

  batch     CompostBatch @relation(fields: [batchId], references: [id])
  feedstock Feedstock    @relation(fields: [feedstockId], references: [id])

  @@map("batch_feedstocks")
}

model CompostingPhase {
  id        String   @id @default(cuid()) @map("phase_id")
  batchId   String   @map("batch_id")
  phaseName String   @map("phase_name")
  timestamp DateTime @default(now()) @map("timestamp")
  status    String   @default("active")

  batch CompostBatch @relation(fields: [batchId], references: [id])

  @@map("composting_phases")
}

model Sensor {
  id         String  @id @default(cuid()) @map("sensor_id")
  machineId  String  @map("machine_id")
  sensorType String  @map("sensor_type")
  location   String?
  unit       String?
  status     String  @default("active")

  machine        Machine         @relation(fields: [machineId], references: [id])
  sensorReadings SensorReading[]

  @@map("sensors")
}

model SensorReading {
  id         String   @id @default(cuid()) @map("reading_id")
  batchId    String   @map("batch_id")
  sensorId   String   @map("sensor_id")
  recordedAt DateTime @default(now()) @map("recorded_at")
  value      Float

  batch  CompostBatch @relation(fields: [batchId], references: [id])
  sensor Sensor       @relation(fields: [sensorId], references: [id])

  @@map("sensor_readings")
}
