generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  address String?
  status  String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  machines Machine[]
  intakes  IntakeRecord[]
  batches  CompostBatch[]

  @@map("organizations")
}

model User {
  id             String  @id /// Clerk User ID (user_2bX...)
  organizationId String?
  fullName       String?
  email          String  @unique
  contactNumber  String?
  role           String  @default("user")
  status         String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id])
  intakes      IntakeRecord[]
  alerts       Alert[]        @relation("ResolvedAlerts")

  @@map("users")
}

// 1. COMBINED MACHINE & CONTROLLER
model Machine {
  id             String    @id @default(cuid())
  organizationId String
  macAddress     String    @unique // From controller
  name           String // From machine
  status         String    @default("active")
  lastSeen       DateTime? // From controller

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  batches      CompostBatch[]
  alerts       Alert[]

  @@map("machines")
}

model IntakeRecord {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  intakeDate     DateTime
  totalWeight    Float
  status         String
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  items        IntakeItem[]
  compostBatch CompostBatch?

  @@map("intake_records")
}

model Feedstock {
  id          String  @id @default(cuid())
  name        String
  category    String
  description String?
  status      String  @default("active")

  intakeItems IntakeItem[]

  @@map("feedstocks")
}

model IntakeItem {
  id          String @id @default(cuid())
  intakeId    String
  feedstockId String
  weight      Float

  intake    IntakeRecord @relation(fields: [intakeId], references: [id])
  feedstock Feedstock    @relation(fields: [feedstockId], references: [id])

  @@map("intake_items")
}

model CompostBatch {
  id             String    @id @default(cuid())
  organizationId String
  machineId      String
  intakeId       String    @unique
  batchCode      String    @unique
  startDate      DateTime
  completionDate DateTime?
  status         String
  targetCnRatio  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  machine          Machine           @relation(fields: [machineId], references: [id])
  intake           IntakeRecord      @relation(fields: [intakeId], references: [id])
  compostOutput    CompostOutput?
  mlPredictions    MlPrediction[]
  compostingPhases CompostingPhase[]
  sensorReadings   SensorReading[]
  alerts           Alert[]

  @@map("compost_batches")
}

model CompostOutput {
  id             String    @id @default(cuid())
  batchId        String    @unique
  outputWeight   Float
  maturityStatus String
  productionDate DateTime
  collectionDate DateTime?
  status         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch CompostBatch @relation(fields: [batchId], references: [id])

  @@map("compost_outputs")
}

model MlPrediction {
  id              String   @id @default(cuid())
  batchId         String
  predictedPhase  String
  confidenceScore Float
  isStabilized    Boolean  @default(false)
  predictionTime  DateTime @default(now())

  batch CompostBatch @relation(fields: [batchId], references: [id])

  @@map("ml_predictions")
}

model CompostingPhase {
  id        String    @id @default(cuid())
  batchId   String
  phaseName String
  startTime DateTime
  endTime   DateTime?
  status    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch CompostBatch @relation(fields: [batchId], references: [id])

  @@map("composting_phases")
}

// 2. FLATTENED HORIZONTAL SCHEMA
model SensorReading {
  id        String   @id @default(cuid())
  batchId   String
  timestamp DateTime @default(now())

  tempTop    Float?
  tempMid    Float?
  tempBottom Float?
  moisture1  Float?
  moisture2  Float?
  co2        Float?
  o2         Float?

  batch CompostBatch @relation(fields: [batchId], references: [id])

  @@map("sensor_readings")
}

model Alert {
  id        String  @id @default(cuid())
  batchId   String?
  machineId String?
  userId    String? // The user who resolved it
  alertType String
  severity  String
  message   String
  status    String

  createdAt DateTime @default(now())

  batch   CompostBatch? @relation(fields: [batchId], references: [id])
  machine Machine?      @relation(fields: [machineId], references: [id])
  user    User?         @relation("ResolvedAlerts", fields: [userId], references: [id])

  @@map("alerts")
}
