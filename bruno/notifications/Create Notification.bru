meta {
  name: Create Notification
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/notifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "machine",
    "severity": "critical",
    "title": "Machine Overheat Warning",
