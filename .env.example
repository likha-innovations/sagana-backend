# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Clerk Authentication Keys
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks)
CLERK_WEBHOOK_SECRET="whsec_..."

# Server Settings
PORT=3000
API_PREFIX="api"
NODE_ENV="development"

# MQTT Broker (HiveMQ)
MQTT_HOST="your-cluster.s1.eu.hivemq.cloud"
MQTT_PORT=8883
MQTT_PROTOCOL="mqtts"
MQTT_USERNAME="your-mqtt-username"
MQTT_PASSWORD="your-mqtt-password"
MQTT_CLIENT_ID="sagana_backend"